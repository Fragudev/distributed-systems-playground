<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.fgutierrez.dsplayground</groupId>
  <artifactId>distributed-systems-playground</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Distributed Systems Playground</name>
  <description>
    Focused, production-quality examples demonstrating distributed-systems patterns
    over a shared generic order-processing domain. See README.md for the example index.
  </description>

  <!--
    This is a build-only aggregator, not a domain parent. Each example under examples/ is a
    self-contained, independently readable Spring Boot application; this POM exists to share
    dependency/plugin versions and to let `./mvnw verify` build everything at once in CI.
    See docs/adr/0001-repo-structure.md and 0002-duplicated-domain.md.
  -->
  <modules>
    <module>examples/synchronous-processing</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- So Spring MVC can resolve @PathVariable/@RequestParam names via reflection without
         every one needing an explicit @PathVariable("name"). -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <spring-boot.version>3.5.3</spring-boot.version>
    <testcontainers.version>1.20.4</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!--
              Testcontainers' bundled docker-java probes the daemon with API version 1.32 by
              default. Some modern Docker Engine builds (e.g. Rancher Desktop 29.x) reject
              anything below 1.41. Pinning the probe here satisfies both old and new daemons
              without every contributor needing to know this.
            -->
            <argLine>-Dapi.version=1.45</argLine>
            <!--
              A second, separate Rancher Desktop quirk: a second Spring context opening its own
              HikariCP pool against an already-running Testcontainers Postgres — reusing the same
              forked JVM a prior test class already used one in — reliably gets ECONNREFUSED for
              the DataSourceHealthIndicator until Hikari's connection-timeout is exhausted, even
              though the container is genuinely healthy and the very first context to use it in
              that JVM connects fine. A fresh fork per test class sidesteps whatever host-network
              state this leaves behind; each example here only has a handful of test classes, so
              the extra JVM startup cost is negligible.
            -->
            <reuseForks>false</reuseForks>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>2.44.3</version>
          <configuration>
            <java>
              <googleJavaFormat/>
            </java>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
