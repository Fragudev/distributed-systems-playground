# Copy to .env and override only the ports that collide with something already running on your
# machine. Every value here is docker-compose.yml's own default — an empty/absent .env behaves
# identically to not having one.

DSPLAYGROUND_POSTGRES_PORT=5432
DSPLAYGROUND_KAFKA_PORT=9092
DSPLAYGROUND_KAFKA_UI_PORT=8090
DSPLAYGROUND_RABBITMQ_PORT=5672
DSPLAYGROUND_RABBITMQ_MGMT_PORT=15672
DSPLAYGROUND_GRAFANA_PORT=3000
DSPLAYGROUND_OTLP_GRPC_PORT=4317
DSPLAYGROUND_OTLP_HTTP_PORT=4318
